# Copy to .env for local development. On Render, set these in the
# service's Environment tab instead — never commit real keys.

PORT=3000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API.
# Add your GitHub Pages URL once deployed, e.g.
#   https://your-username.github.io
CORS_ORIGINS=http://localhost:4200

# --- Email (optional) ---
# Get a key at https://resend.com (free tier: 3,000 emails/month).
# If RESEND_API_KEY is unset, contact submissions are logged instead of emailed.
RESEND_API_KEY=
# Must be a domain you've verified in Resend. Until you verify one, Resend
# allows onboarding@resend.dev for testing.
CONTACT_FROM=onboarding@resend.dev
# Where contact form submissions get delivered.
CONTACT_TO=ivanhua631@gmail.com
